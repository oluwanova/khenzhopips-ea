rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rule for the 'users' collection
    // Logged-in users can only read their own data.
    // Only your backend (Cloud Functions) can write to this collection.
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if false; 
    }
    
    // Rule for the 'sessions' collection (for your EA)
    // Logged-in users can create, read, and delete their OWN session documents.
    match /sessions/{userId}/{sessionId} {
      allow read, create, delete: if request.auth.uid == userId;
      allow write: if false;
    }
    
    // Rule for the 'messages' collection (from your contact form)
    // ANYONE can create (submit) a message.
    // ONLY an admin can read, update, or delete messages.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}