// storage.rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for product files, e.g., "products/sentinel.zip"
    match /products/{productId} {

      // DENY client-side reads. All downloads must go through your secure
      // Cloud Function, which generates temporary signed URLs.
      allow read: if false;

      // ALLOW writes (upload, update, delete) ONLY if the user is authenticated
      // and their ID token contains the custom claim 'admin' set to true.
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}